{
  description = "Julia environment for the double-descent replication";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs?ref=nixos-unstable";
  };

  outputs = {nixpkgs, ...}: let
    system = "x86_64-linux";
    pkgs = nixpkgs.legacyPackages.${system};
  in {
    devShells.${system} = {
      default = pkgs.mkShell {
        JULIA_PROJECT = ".";
        buildInputs = with pkgs; [
          julia-bin
          unzip
        ];
      };
    };
  };
}
